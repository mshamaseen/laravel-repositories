{
    "name": "shamaseen/laravel-repositories",
    "description": "repository pattern files generator",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mohammad Shamaseen",
            "email": "m.shamaseen@outlook.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Shamaseen\\Repository\\RepositoryServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Shamaseen\\Repository\\Tests\\": "tests/",
            "Shamaseen\\Repository\\": "src/",
            "App\\": "tests/results/app/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "shamaseen/laravel-files-generator": "^1.0",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "orchestra/testbench": "^11.0"
    }
}